@startuml C4_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

System_Boundary(c1, "Simplexl OS Firmware") {
    Container(core, "Core Component (sx_core)", "C", "Manages state, events, and lifecycle. The central nervous system.")
    Container(services, "Service Layer (sx_services)", "C", "Provides all business logic: audio, WiFi, radio, intents, etc.")
    Container(ui, "UI Component (sx_ui)", "C", "Manages LVGL screens, user input, and rendering.")
    Container(platform, "Platform Layer (sx_platform)", "C", "Hardware Abstraction Layer (HAL) for display, audio codec, SPI.")

    Rel(ui, core, "Posts UI events to", "Event Queue")
    Rel(core, ui, "Updates UI via", "State Snapshot")

    Rel(services, core, "Posts service events to", "Event Queue")
    Rel(core, services, "Dispatches commands to", "Event Handlers")

    Rel(services, platform, "Uses hardware via", "HAL API")
    Rel(ui, platform, "Uses hardware via", "HAL API")
}

@enduml